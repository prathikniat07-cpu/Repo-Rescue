# RepoRescue Backend Environment Variables
# Copy this to .env and fill in your values

# GitHub Personal Access Token (optional but recommended to avoid rate limits)
# Create one at: https://github.com/settings/tokens
GITHUB_TOKEN=

# AI API Keys - provide at least ONE
# Google Gemini API Key (free tier available): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OR OpenAI API Key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
