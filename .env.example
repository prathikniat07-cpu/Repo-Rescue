# RepoRescue Environment Variables
# Copy these into your Vercel Project Settings > Environment Variables

# Google Gemini API Key (Required for AI analysis and repository Q&A)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: GitHub Personal Access Token (Increases rate limit from 60 req/hr to 5,000 req/hr)
GITHUB_TOKEN=your_github_token_here
